import os
from yt_dlp import YoutubeDL

def download_youtube_as_wav(url, output_directory):
    # 保存先ディレクトリが存在しない場合は作成
    if not os.path.exists(output_directory):
        os.makedirs(output_directory)
        print(f"ディレクトリを作成しました: {output_directory}")

    # yt-dlpの設定オプション
    ydl_opts = {
        'format': 'bestaudio/best',  # 最高音質の音声をダウンロード
        'outtmpl': os.path.join(output_directory, '%(title)s.%(ext)s'),  # 出力パスとファイル名指定
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'wav',  # wav形式を指定
            'preferredquality': '0',  # 最高品質（自動調整）
        }],
    }

    print("ダウンロードと変換を開始します...")
    with YoutubeDL(ydl_opts) as ydl:
        ydl.download([url])
    print("完了しました！")

# 使い方
youtube_url = "https://youtu.be/JhoK7chbpZ0?si=vo-xHMHphH0RAtKL"  # ここにURLを入力
output_dir = "/Users/honndakaisei/Creation/Python/sabi_model/audio2"  # ここに保存したいディレクトリのパスを入力

download_youtube_as_wav(youtube_url, output_dir)